{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "../../../",
  "testMatch": ["<rootDir>/apps/api/test/**/*.e2e-spec.ts"],
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/apps/api/tsconfig.app.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@app/([^/]+)/(.*)$": "<rootDir>/libs/$1/src/$2",
    "^@app/([^/]+)$": "<rootDir>/libs/$1/src"
  }
}
