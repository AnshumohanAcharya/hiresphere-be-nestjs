// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ONBOARDING & PROFILE MODULE
// ==========================================

enum OnboardingStatus {
  AWAITING_PROFILE
  AWAITING_RESUME
  COMPLETED
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String?
  password       String
  onboardingStep OnboardingStatus @default(AWAITING_PROFILE)

  // Profile & Preferences
  targetRoles     String[] // e.g. ["Fullstack Developer", "Backend Engineer"]
  targetLocations String[]
  minSalary       Int?
  preferredStack  String[] // e.g. ["Node.js", "Python", "AWS"]

  // Relations
  resumes           Resume[]
  jobs              JobApplication[]
  interviews        InterviewSession[]
  outreachCampaigns OutreachCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 2. JOB AGGREGATOR MODULE (UPDATED via LLD)
// ==========================================

enum JobSource {
  LINKEDIN
  INDEED
  GLASSDOOR
  OTHER
}

model Company {
  id           String   @id @default(uuid())
  name         String   @unique // 👈 ADD THIS @unique
  industry     String?
  domain       String?
  linkedinUrl  String?
  
  jobs         Job[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("companies")
}
model Job {
  id         String @id @default(uuid())
  externalId String @unique // LLD: external_id (Critical for deduplication)

  // Source & Relations
  source    JobSource
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])

  title    String
  location String?

  // Description Fields (LLD: raw & cleaned split)
  rawDescription     String  @db.Text
  cleanedDescription String? @db.Text

  // Salary Data
  salaryRaw   String? // Original scraped text (e.g. "$100k - $120k")
  salaryRange Decimal? @db.Decimal(10, 2) // LLD: salary_range (Numeric)

  url      String
  postedAt DateTime? // LLD: posted_at

  // Scraper Metadata
  isProcessed    Boolean @default(false)
  relevanceScore Float? // Calculated by Python AI service

  // Relations
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

model Scrape {
  id          String    @id @default(uuid())
  workerId    String
  status      String // e.g., "completed", "failed"
  jobsFound   Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("scrapes")
}

// ==========================================
// 3. RESUME & COVER LETTER MODULE
// ==========================================

model Resume {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name     String // e.g., "Software Engineer v1"
  isMaster Boolean @default(false)
  content  Json // The structured resume data
  fileUrl  String? // S3 link to the PDF

  tailoredDocs TailoredDocument[]
  createdAt    DateTime           @default(now())
}

model TailoredDocument {
  id       String @id @default(uuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id])
  jobId    String

  docType         String // "RESUME" or "COVER_LETTER"
  tailoredContent Json
  matchScore      Int
  pdfUrl          String?

  createdAt DateTime @default(now())
}

// ==========================================
// 4. COLD OUTREACH MODULE
// ==========================================

enum OutreachStatus {
  PENDING
  SCHEDULED
  SENT
  REPLIED
  STOPPED
}

model OutreachCampaign {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  jobId  String

  status         OutreachStatus @default(PENDING)
  recruiterName  String?
  recruiterEmail String?

  // Sequence Logic
  sequenceStep Int       @default(1)
  nextRunAt    DateTime?

  logs      OutreachLog[]
  createdAt DateTime      @default(now())
}

model OutreachLog {
  id         String           @id @default(uuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id])

  messageType String // "EMAIL" or "LINKEDIN"
  content     String   @db.Text
  sentAt      DateTime @default(now())
}

// ==========================================
// 5. INTERVIEW SIMULATOR MODULE
// ==========================================

model InterviewSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  jobTitle   String
  difficulty String @default("INTERMEDIATE")

  // Real-time Data
  transcript  Json // Array of {role: "interviewer", text: "..."}
  audioRecord String? // URL to recording in S3

  // AI Feedback
  feedback   Json? // Summary, strengths, and weaknesses
  finalScore Int?

  createdAt DateTime @default(now())
}

// ==========================================
// 6. TRACKING / ANALYTICS
// ==========================================

model JobApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id])

  status    String    @default("DISCOVERED") // DISCOVERED, APPLIED, INTERVIEWING, OFFER, REJECTED
  appliedAt DateTime?
  createdAt DateTime  @default(now())
}
